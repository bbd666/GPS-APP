<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="0.0 km/h"
            android:textColor="#007ACC"
            android:textSize="48sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <View
                android:id="@+id/viewOsmIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="#CCCCCC" />

            <TextView
                android:id="@+id/tvCurrentLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limite : 50 km/h"
                android:textColor="#555555"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="limitation inconnue"
            android:textColor="#FF9800"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

        <Button
            android:id="@+id/btnActivateOsm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Réactiver mode OSM"
            android:visibility="gone"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Latitude : 0.0\nLongitude : 0.0"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:text="Définir la limite manuelle :"
            android:textColor="#777777"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button android:id="@+id/btnLimit30" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Zone 30 km/h" />
        <Button android:id="@+id/btnLimit50" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Agglomération 50 km/h" />
        <Button android:id="@+id/btnLimit70" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Route 70 km/h" />
        <Button android:id="@+id/btnLimit80" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Route 80 km/h" />
        <Button android:id="@+id/btnLimit90" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Route 90 km/h" />
        <Button android:id="@+id/btnLimit110" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Voie Rapide 110 km/h" />
        <Button android:id="@+id/btnLimit130" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:text="Autoroute 130 km/h" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnChangeDatabase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Changer de base"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvDbName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Aucune base chargée"
            android:textColor="#999999"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnStopApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Arrêter l'application"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
